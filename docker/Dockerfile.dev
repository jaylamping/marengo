# Marengo development image — source of truth for CI, Compose, and Dev Container.
FROM rust:1.85.0-bookworm

ARG PROTOC_VERSION=28.3
ARG NODE_MAJOR=22
ARG MARENGO_UID=1000
ARG MARENGO_GID=1000
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    WORKSPACE=/workspace

# protoc (pinned, arch-aware), Node 22, cross toolchain, CAN/vcan tools, git-lfs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    git-lfs \
    pkg-config \
    libssl-dev \
    gcc-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    iproute2 \
    can-utils \
    kmod \
    python3 \
    python3-pip \
    gosu \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
         arm64|aarch64) PROTOC_ARCH="aarch_64" ;; \
         *) PROTOC_ARCH="x86_64" ;; \
       esac \
    && curl -fsSL "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
        -o /tmp/protoc.zip \
    && unzip -q /tmp/protoc.zip -d /usr/local \
    && rm /tmp/protoc.zip \
    && protoc --version \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version \
    && git lfs install

# cargo-deny 0.16.x matches Rust 1.85; advisory-db pinned before CVSS 4.0 entries (cargo-deny 0.16 cannot parse them)
ARG ADVISORY_DB_REV=808b5a554ded31fe41863ecf7c9abf4c26e8cfcd
RUN cargo install cargo-deny --locked --version 0.16.3 \
    && cargo install cargo-audit --locked \
    && mkdir -p /usr/local/cargo/advisory-db-pinned \
    && git clone https://github.com/RustSec/advisory-db.git \
        /usr/local/cargo/advisory-db-pinned/github.com-a946fc29ac602819 \
    && git -C /usr/local/cargo/advisory-db-pinned/github.com-a946fc29ac602819 checkout "${ADVISORY_DB_REV}"

RUN groupadd -g "${MARENGO_GID}" marengo 2>/dev/null || true \
    && useradd -m -u "${MARENGO_UID}" -g "${MARENGO_GID}" -s /bin/bash marengo 2>/dev/null || true \
    && mkdir -p "${WORKSPACE}" && chown -R marengo:marengo "${WORKSPACE}" /usr/local/cargo

WORKDIR ${WORKSPACE}

# Match rust-toolchain.toml (as marengo before installing entrypoint)
USER marengo
RUN rustup component add rustfmt clippy \
    && rustup target add aarch64-unknown-linux-gnu

USER root
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["bash"]
