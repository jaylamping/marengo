# Marengo development image — source of truth for CI, Compose, and Dev Container.
FROM rust:1.85.0-bookworm

ARG PROTOC_VERSION=28.3
ARG NODE_MAJOR=22
ARG MARENGO_UID=1000
ARG MARENGO_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    WORKSPACE=/workspace

# protoc (pinned), Node 22, cross toolchain, CAN/vcan tools, git-lfs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    git-lfs \
    pkg-config \
    libssl-dev \
    gcc-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    iproute2 \
    can-utils \
    kmod \
    python3 \
    python3-pip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" \
        -o /tmp/protoc.zip \
    && unzip -q /tmp/protoc.zip -d /usr/local \
    && rm /tmp/protoc.zip \
    && protoc --version \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version \
    && git lfs install

# cargo-deny, cargo-audit for check.sh (install as root before switching user)
RUN cargo install cargo-deny --locked --version 0.16.3 2>/dev/null || cargo install cargo-deny --locked \
    && cargo install cargo-audit --locked 2>/dev/null || true

RUN groupadd -g "${MARENGO_GID}" marengo 2>/dev/null || true \
    && useradd -m -u "${MARENGO_UID}" -g "${MARENGO_GID}" -s /bin/bash marengo 2>/dev/null || true \
    && mkdir -p "${WORKSPACE}" && chown -R marengo:marengo "${WORKSPACE}" /usr/local/cargo

WORKDIR ${WORKSPACE}
USER marengo

# Match rust-toolchain.toml
RUN rustup component add rustfmt clippy

CMD ["/bin/bash"]
