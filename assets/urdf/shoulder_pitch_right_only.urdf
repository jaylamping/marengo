<?xml version="1.0"?>
<!-- Single right shoulder pitch for isolated bench bring-up.
     Matches config/bringup/shoulder_pitch_right_only/robot.yaml.
     Limits and safety_controller match shoulder_pitch_weighted.urdf for consistency. -->
<robot name="marengo_shoulder_pitch_right_only">
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <material name="mount_gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  <link name="right_upper_arm_stub">
    <inertial>
      <!-- 2026-06-19: 0.70 kg total (18 in arm, mass concentrated at tip); COM = 18 in (0.4572 m) from joint. Mirror of shoulder_pitch_weighted.urdf right link. -->
      <mass value="0.7"/>
      <origin xyz="0 0 -0.4572" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.4"/>
      </geometry>
      <material name="arm_blue">
        <color rgba="0.23 0.51 0.96 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="right_upper_arm_stub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="3.17" effort="10" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.872665" soft_upper_limit="3.141593" k_position="10" k_velocity="1"/>
  </joint>
</robot>
