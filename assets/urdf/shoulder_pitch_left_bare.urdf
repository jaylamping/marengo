<?xml version="1.0"?>
<!-- Measured 75 g dowel; model mass 83 g (+11%) — mirror of right bare bench URDF. -->
<robot name="shoulder_pitch_left_bare">
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <link name="left_upper_arm_stub">
    <inertial>
      <mass value="0.083"/>
      <origin xyz="0 0 -0.200025" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="left_upper_arm_stub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.65" effort="10" velocity="2.0"/>
  </joint>
</robot>
