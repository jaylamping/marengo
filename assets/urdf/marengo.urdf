<?xml version="1.0"?>
<!-- Master live URDF — right 4-DOF bench (promoted from arm_4dof_right.urdf).
     Matches config/robot.yaml. Pi path: /opt/marengo/assets/urdf/marengo.urdf.
     PROVISIONAL: masses/COM/link lengths are ballpark until CAD export.
     Axes per hardware/docs/kinematics.md (right arm table). -->
<robot name="marengo_arm_4dof_right">
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <material name="mount_gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  <link name="right_shoulder_pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  <link name="right_shoulder_roll_link">
    <inertial>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  <link name="right_upper_arm_link">
    <inertial>
      <mass value="0.55"/>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.24"/>
      </geometry>
      <material name="arm_blue">
        <color rgba="0.23 0.51 0.96 1"/>
      </material>
    </visual>
  </link>
  <link name="right_forearm_link">
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.2"/>
      </geometry>
      <material name="forearm_blue">
        <color rgba="0.35 0.6 0.95 1"/>
      </material>
    </visual>
  </link>
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="right_shoulder_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="3.25" effort="60" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.872665" soft_upper_limit="3.20" k_position="10" k_velocity="1"/>
  </joint>
  <joint name="right_shoulder_roll" type="revolute">
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="3.14159" effort="60" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.05" soft_upper_limit="3.14159" k_position="10" k_velocity="1"/>
  </joint>
  <joint name="right_upper_arm_yaw" type="revolute">
    <parent link="right_shoulder_roll_link"/>
    <child link="right_upper_arm_link"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="17" velocity="2.0"/>
    <safety_controller soft_lower_limit="-1.57" soft_upper_limit="1.57" k_position="10" k_velocity="1"/>
  </joint>
  <!-- Bench-measured envelope (Set Limits 2026-07-22); Davout hard = URDF ∩ motors.yaml. -->
  <joint name="right_elbow_pitch" type="revolute">
    <parent link="right_upper_arm_link"/>
    <child link="right_forearm_link"/>
    <origin xyz="0 0 -0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.50" upper="1.2" effort="17" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.50" soft_upper_limit="1.15" k_position="10" k_velocity="1"/>
  </joint>
</robot>
