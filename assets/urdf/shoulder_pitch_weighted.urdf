<?xml version="1.0"?>
<!-- Weighted bench URDF: asymmetric load for gravity sign validation.
     Left: bare dowel only (83 g, COM 200 mm). Right: dowel + mallet fixture (measured).
     Update mass via scripts/bench-set-weighted-mass.sh <kg> right|left; adjust COM if lever arm changes. -->
<robot name="shoulder_pitch_weighted">
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <link name="left_upper_arm_stub">
    <inertial>
      <mass value="0.083"/>
      <origin xyz="0 0 -0.200025" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <link name="right_upper_arm_stub">
    <inertial>
      <!-- 2026-06-11: 0.70 kg total (dowel + rubber mallet at tip); COM ≈ 18 in from joint -->
      <mass value="0.7"/>
      <origin xyz="0 0 -0.4572" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="left_upper_arm_stub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="3.17" effort="10" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.872665" soft_upper_limit="3.141593" k_position="10" k_velocity="1"/>
  </joint>
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="right_upper_arm_stub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.9" upper="3.17" effort="10" velocity="2.0"/>
    <safety_controller soft_lower_limit="-0.872665" soft_upper_limit="3.141593" k_position="10" k_velocity="1"/>
  </joint>
</robot>
