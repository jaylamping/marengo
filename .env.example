# Copy to .env for local overrides (never commit .env).

# Chappe / IPC (future)
# CHAPPE_URL=nats://localhost:4222

# Jetson / vision (future)
# JETSON_HOST=marengo-jetson.local

# Consul dev server (future)
# CONSUL_DEV_PORT=5173

# Logging
# Default to `info` everywhere. Do NOT use `marengo=debug` as a default: it turns
# on DEBUG for every marengo crate, including the IMU's per-sample (~30 Hz)
# `published ImuSample` log, which floods the Chappe bus / structured-log DB.
# Raise a single subsystem only when needed, e.g. `info,marengo_pi::imu=debug`.
RUST_LOG=info
