# Pi / robot-hosted production build (vite build --mode production).
# Empty anchors override consul/.env.local dev URLs during deploy.
# Runtime derives HTTP/WebTransport from page origin — see ADR 0008.

VITE_CHAPPE_HTTP_URL=
VITE_CHAPPE_WEBTRANSPORT_URL=

# Operator laptop loopback after Durable Set Limits (`just limit-sync-serve`).
# Baked into Pi UI so Apply from https://marengo.local:8444 can sync the checkout.
VITE_LIMIT_SYNC_URL=http://127.0.0.1:8790
