{
  "name": "consul",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "gen:proto": "buf generate --template buf.gen.yaml ../proto",
    "predev": "npm run gen:proto",
    "prebuild": "npm run gen:proto",
