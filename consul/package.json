    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "lint:base-ui": "vitest run src/components/ui/__tests__/base-ui-lint-gate.test.ts"
  },
