# Copy to consul/.env.local for live bench telemetry (ADR 0008).
# Trust the gateway self-signed cert once: open VITE_CHAPPE_WEBTRANSPORT_URL in the browser.

VITE_CHAPPE_HTTP_URL=http://127.0.0.1:8080
VITE_CHAPPE_WEBTRANSPORT_URL=https://127.0.0.1:8443/chappe

# Pi via SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 -L 8443:127.0.0.1:8443 joey@marengo.local
