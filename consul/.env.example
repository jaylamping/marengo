# Copy to consul/.env.local for local Vite dev only (npm run dev on :5173).
# Robot-hosted / deploy builds use consul/.env.production (empty VITE_CHAPPE_* anchors);
# deploy-pi.sh scrubs shell VITE_CHAPPE_* and rejects poisoned dist via check-consul-dist.sh.
# Open https://marengo.local:8444 on the Pi LAN — no .env.local on the robot.
# Pi gateway: HTTP :8080, HTTPS UI :8444, WebTransport :8443 (bench only — not for the public internet).

VITE_CHAPPE_HTTP_URL=http://marengo.local:8080
VITE_CHAPPE_WEBTRANSPORT_URL=https://marengo.local:8443/chappe

# Local demo (gateway on this Mac): cargo run -p marengo-gateway -- --demo
# VITE_CHAPPE_HTTP_URL=http://127.0.0.1:8080
# VITE_CHAPPE_WEBTRANSPORT_URL=https://127.0.0.1:8443/chappe

# SSH -L does not forward QUIC; do not use a tunnel for :8443 WebTransport.

# Match Pi MARENGO_GATEWAY_LOG_TOKEN for Logs / config PATCH against a tokenized gateway.
# Deploy (deploy-pi.sh) bakes this automatically from the Pi when unset — do not commit the token.
# VITE_MARENGO_LOG_TOKEN=

# Compound Tests → Auto Learn (local BFF only; never commit secrets).
# Prefer consul/.env.development.local so `vite build` / Pi deploy cannot bake these in.
# Run: cd tools/compound-auto-learn && CURSOR_API_KEY=… AUTO_LEARN_TOKEN=… npm start
# VITE_AUTO_LEARN_URL=http://127.0.0.1:8787
# VITE_AUTO_LEARN_TOKEN=

# Required for local Durable Set Limits → git checkout sync (`just limit-sync-serve`).
# Consul warns on Apply when unset. Pi Durable apply still succeeds without it.
# VITE_LIMIT_SYNC_URL=http://127.0.0.1:8790
