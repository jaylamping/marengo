# Copy to consul/.env.local for local Vite dev (npm run dev on :5173).
# Robot-hosted Consul does not need this file — open https://marengo.local:8444 on the Pi LAN.
# Pi gateway: HTTP :8080, HTTPS UI :8444, WebTransport :8443 (bench only — not for the public internet).

VITE_CHAPPE_HTTP_URL=http://marengo.local:8080
VITE_CHAPPE_WEBTRANSPORT_URL=https://marengo.local:8443/chappe

# Local demo (gateway on this Mac): cargo run -p marengo-gateway -- --demo
# VITE_CHAPPE_HTTP_URL=http://127.0.0.1:8080
# VITE_CHAPPE_WEBTRANSPORT_URL=https://127.0.0.1:8443/chappe

# SSH -L does not forward QUIC; do not use a tunnel for :8443 WebTransport.
