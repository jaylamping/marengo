"""Fit check of the snap hooks against the cradle sides, on the exported meshes at 0.1 mm voxels.

Seats each hook, then walks it out along X to show what it meets on the way in. Also sweeps the hook boxes
through parts.json out past the frame side.
"""
import json
from pathlib import Path

import numpy as np
import trimesh

HERE = Path(__file__).parent
PITCH = 0.1
PARTS = json.loads((HERE.parent / "generator" / "parts.json").read_text())["parts"]
LO, HI = np.array([-58.0, 339.0, -16.0]), np.array([-28.0, 351.0, 6.0])  # right side window


def fill(mesh, lo, hi):
    xs = np.arange(lo[0] + PITCH / 2, hi[0], PITCH)
    ys = np.arange(lo[1] + PITCH / 2, hi[1], PITCH)
    zs = np.arange(lo[2] + PITCH / 2, hi[2], PITCH)
    hits = {}
    for tri in mesh.triangles + np.array([1e-4, 0, 2e-4]):
        a, b, c = tri[:, [0, 2]]
        det = (b[1] - c[1]) * (a[0] - c[0]) + (c[0] - b[0]) * (a[1] - c[1])
        if abs(det) < 1e-12:
            continue
        ix = np.where((xs >= tri[:, 0].min()) & (xs <= tri[:, 0].max()))[0]
        iz = np.where((zs >= tri[:, 2].min()) & (zs <= tri[:, 2].max()))[0]
        for i in ix:
            for k in iz:
                u = ((b[1] - c[1]) * (xs[i] - c[0]) + (c[0] - b[0]) * (zs[k] - c[1])) / det
                v = ((c[1] - a[1]) * (xs[i] - c[0]) + (a[0] - c[0]) * (zs[k] - c[1])) / det
                if u >= 0 and v >= 0 and u + v <= 1:
                    hits.setdefault((i, k), []).append(u * tri[0, 1] + v * tri[1, 1] + (1 - u - v) * tri[2, 1])
    out = np.zeros((len(xs), len(ys), len(zs)), bool)
    for (i, k), h in hits.items():
        h = sorted(h)
        for y0, y1 in zip(h[::2], h[1::2]):
            out[i, (ys > y0) & (ys < y1), k] = True
    return out


def main():
    strap = trimesh.load(HERE / "marengo_torso_cradle_top_strap.stl")
    print("strap bounds", np.round(strap.bounds, 3).tolist(), "watertight", strap.is_watertight, "volume", round(strap.volume, 1))
    for s, label in ((-1, "right"), (1, "left")):
        side = trimesh.load(HERE / f"marengo_torso_cradle_side_{label}.stl")
        hook = strap.copy()
        keep = hook.triangles_center[:, 0] * s > 4
        hook.update_faces(keep)
        hook.remove_unreferenced_vertices()
        if s > 0:
            for m in (side, hook):
                m.apply_scale([-1, 1, 1])
        print(label, "hook volume", round(abs(hook.volume), 1), "watertight", hook.is_watertight)
        S, H = fill(side, LO, HI), fill(hook, LO, HI)
        print(" seated overlap voxels", (S & H).sum(), f"= {(S & H).sum() * PITCH**3:.2f} mm3")
        for dx in (0.1, 0.2):
            print(f" shifted in {dx}:", (S & np.roll(H, int(dx / PITCH), 0)).sum(), f" out {dx}:", (S & np.roll(H, -int(dx / PITCH), 0)).sum())
        for dz in (-0.2, -0.4, -0.6, 0.2):
            print(f" shifted Z {dz}:", (S & np.roll(H, int(dz / PITCH), 2)).sum())
        # Walk out along X: which Y band hits the side at each step. The barb and the pin should be all that does.
        yy = np.arange(LO[1] + PITCH / 2, HI[1], PITCH)
        for dx in (0.3, 0.6, 1, 2, 3.5, 4.5, 8):
            n = int(dx / PITCH)
            hit = S[:-n] & H[n:] if n else S & H
            where = np.argwhere(hit)
            if len(where):
                print(f" out {dx}: {len(where)} vox, Y {yy[where[:, 1].min()]:.1f} to {yy[where[:, 1].max()]:.1f}")
            else:
                print(f" out {dx}: clear")
    # Insertion path: hook boxes from the seat out to |X| 130, including the barb height
    for s, x0 in ((-1, 5), (1, 25)):
        a, b = sorted((s * x0, s * 170))
        for p in PARTS:
            bs = [(p["lo"], p["hi"])] if p["type"] == "box" else [tuple(q) for q in p.get("boxes", [])]
            if p["type"] == "cyl":
                i = "xyz".index(p["axis"][-1])
                lo = [v - p["r"] for v in p["c"]]
                hi = [v + p["r"] for v in p["c"]]
                lo[i], hi[i] = p["c"][i] - p["h"] / 2, p["c"][i] + p["h"] / 2
                bs = [(lo, hi)]
            for lo, hi in bs:
                if lo[0] < b and hi[0] > a and lo[1] < 350 and hi[1] > 340.5 and lo[2] < 5 and hi[2] > -15 and not p["id"].startswith(("packrail", "cradle_strap")):
                    print("path", label if s > 0 else "right", p["id"], p["group"], lo, hi)


if __name__ == "__main__":
    main()
"""Overlap and clearance check of the cradle boxes against generator/parts.json (exact box and cylinder maths)."""
import json
import math
from pathlib import Path

HERE = Path(__file__).parent
PARTS = json.loads((HERE.parent / "generator" / "parts.json").read_text())["parts"]

# Right side (-X) solids, mirrored for left below. lo, hi in torso coordinates, mm. Holes are ignored, so this errs high.
RIGHT = {
    "web": ((-51.5, 175, -50), (-48, 353.62, 37.5)),
    "bottom_foot_strip": ((-55, 175, -44), (-51.5, 179, 37.5)),
    "bottom_foot_tongue": ((-75, 175, -21.5), (-55, 179, 21.5)),
    "bottom_root": ((-55, 179, -44), (-51.5, 182.5, 37.5)),
    "top_root": ((-55, 346.12, 5.2), (-51.5, 349.62, 37.5)),
    "top_foot": ((-75, 349.62, -44), (-51.5, 353.62, 37.5)),
    "ledge": ((-48, 179, -45), (-40, 183, 34)),
    "front_lip": ((-48, 179, 34), (-42, 345, 37.5)),
    "boss": ((-59, 244.6, -13), (-51.5, 260.6, 3)),
    "thumbscrew_head": ((-65.5, 243.6, -14), (-59, 261.6, 4)),
    "pad_lo": ((-55.5, 195, 29.5), (-48, 205, 37.5)),
    "pad_hi": ((-55.5, 325, 29.5), (-48, 335, 37.5)),
}
ALL = dict(RIGHT)
ALL.update({"L_" + k: ((-hi[0], lo[1], lo[2]), (-lo[0], hi[1], hi[2])) for k, (lo, hi) in RIGHT.items()})
for s, n, inner in ((-1, "r", 5), (1, "l", 25)):
    def side(x0, x1, y0, y1, z0, z1):
        a, b = sorted((s * x0, s * x1))
        return (a, y0, z0), (b, y1, z1)

    ALL[f"strap_rail_{n}"] = side(inner, 51.7, 345.5, 348.5, -7, 5)
    ALL[f"strap_root_{n}"] = side(inner, 30, 345.5, 348.5, -15, -7)
    ALL[f"strap_tongue_{n}"] = side(30, 47.8, 346.9, 348.5, -15, -7.8)
    ALL[f"strap_barb_{n}"] = side(42.8, 47.8, 348.5, 350, -15, -7.8)
    ALL[f"strap_lip_{n}"] = side(51.7, 54.2, 340.5, 348.5, -15, 5)


def boxes_of(p):
    """Bounding boxes of one parts.json entry."""
    if p["type"] == "box":
        return [(p["lo"], p["hi"])]
    if p["type"] == "multibox":
        return [tuple(b) for b in p["boxes"]]
    if p["type"] == "cyl":
        i = "xyz".index(p["axis"][-1])
        lo = [v - p["r"] for v in p["c"]]
        hi = [v + p["r"] for v in p["c"]]
        lo[i], hi[i] = p["c"][i] - p["h"] / 2, p["c"][i] + p["h"] / 2
        return [(lo, hi)]
    if p["type"] == "poly":
        xs, ys = zip(*p["pts"])
        z0 = p["z0"]
        z1 = z0 + p.get("t", 3)
        return [([min(xs), min(ys), min(z0, z1)], [max(xs), max(ys), max(z0, z1)])]
    return []


def gap(a, b):
    """Per-axis signed gaps: negative on all three means overlap by that much."""
    return [max(a[0][i] - b[1][i], b[0][i] - a[1][i]) for i in range(3)]


rows = []
for name, box in ALL.items():
    for p in PARTS:
        for b in boxes_of(p):
            g = gap(box, b)
            if max(g) < 0:
                rows.append(("OVERLAP", name, p["id"], p["group"], [round(-v, 2) for v in g]))
            elif max(g) == 0 and sum(v == 0 for v in g) == 1:
                rows.append(("touch", name, p["id"], p["group"], [round(v, 2) for v in g]))
            elif 0 < max(g) < 2 and all(v < 2 for v in g):
                rows.append(("near", name, p["id"], p["group"], [round(v, 2) for v in g]))

for r in rows:
    print(*r)
print("skipped", [p["id"] for p in PARTS if not boxes_of(p)])

# Same question on the exported meshes, at the voxel pitch of mass_estimate.py, so holes and windows count.
import numpy as np  # noqa: E402
import trimesh  # noqa: E402

from mass_estimate import PITCH, fill  # noqa: E402

for path in sorted(HERE.glob("*.stl")):
    mesh = trimesh.load(path)
    grid = fill(mesh)
    lo = mesh.bounds[0]
    pts = (np.argwhere(grid) + 0.5) * PITCH + lo
    for p in PARTS:
        for b in boxes_of(p):
            n = np.all((pts > np.array(b[0]) + 1e-6) & (pts < np.array(b[1]) - 1e-6), axis=1).sum()
            if n:
                print("MESH", path.stem, p["id"], p["group"], f"{n * PITCH**3:.0f} mm3")
"""Print mass of each cradle STL: solid, and 4 walls + 15 % gyroid (voxel estimate). Also checks mesh bounds."""
from pathlib import Path

import numpy as np
import trimesh
from scipy import ndimage

RHO = 1.27e-3  # g/mm3, PETG
PITCH = 0.4  # mm
WALL = 4 * 0.42  # mm, 4 perimeters of 0.42 lines; top and bottom skins treated the same


def fill(mesh):
    """Voxel grid by parity along Y through the triangle soup, no third-party ray engine needed."""
    lo, hi = mesh.bounds
    xs = np.arange(lo[0] + PITCH / 2, hi[0], PITCH)
    ys = np.arange(lo[1] + PITCH / 2, hi[1], PITCH)
    zs = np.arange(lo[2] + PITCH / 2, hi[2], PITCH)
    hits = [[] for _ in range(len(xs) * len(zs))]
    jitter = np.array([1e-4, 0, 2e-4])  # keeps columns off shared triangle edges
    for tri in mesh.triangles + jitter:
        a, b, c = tri[:, [0, 2]]
        det = (b[1] - c[1]) * (a[0] - c[0]) + (c[0] - b[0]) * (a[1] - c[1])
        if abs(det) < 1e-12:
            continue
        ix = np.where((xs >= tri[:, 0].min()) & (xs <= tri[:, 0].max()))[0]
        iz = np.where((zs >= tri[:, 2].min()) & (zs <= tri[:, 2].max()))[0]
        for i in ix:
            for k in iz:
                u = ((b[1] - c[1]) * (xs[i] - c[0]) + (c[0] - b[0]) * (zs[k] - c[1])) / det
                v = ((c[1] - a[1]) * (xs[i] - c[0]) + (a[0] - c[0]) * (zs[k] - c[1])) / det
                if u >= 0 and v >= 0 and u + v <= 1:
                    hits[i * len(zs) + k].append(u * tri[0, 1] + v * tri[1, 1] + (1 - u - v) * tri[2, 1])
    out = np.zeros((len(xs), len(ys), len(zs)), bool)
    for i in range(len(xs)):
        for k in range(len(zs)):
            h = sorted(hits[i * len(zs) + k])
            for y0, y1 in zip(h[::2], h[1::2]):
                out[i, (ys > y0) & (ys < y1), k] = True
    return out


def main():
    for path in sorted(Path(__file__).parent.glob("*.stl")):
        mesh = trimesh.load(path)
        grid = np.pad(fill(mesh), 1)
        depth = ndimage.distance_transform_edt(grid) * PITCH
        shell = (depth > 0) & (depth <= WALL)
        core = depth > WALL
        v_vox = grid.sum() * PITCH**3
        v_print = (shell.sum() + 0.15 * core.sum()) * PITCH**3
        print(path.stem, "watertight", mesh.is_watertight, "bounds", np.round(mesh.bounds, 2).tolist())
        print(f"  volume {mesh.volume:.0f} mm3, solid {mesh.volume * RHO:.1f} g; 4 walls/15 % {v_print / v_vox * mesh.volume * RHO:.1f} g"
              f" (shell share {shell.sum() / grid.sum():.0%})")


if __name__ == "__main__":
    main()

