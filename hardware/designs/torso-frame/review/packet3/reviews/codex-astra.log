    ALL[f"strap_tongue_{n}"] = side(30, 47.8, 346.9, 348.5, -15, -7.8)
    ALL[f"strap_barb_{n}"] = side(42.8, 47.8, 348.5, 350, -15, -7.8)
    ALL[f"strap_lip_{n}"] = side(51.7, 54.2, 340.5, 348.5, -15, 5)


def boxes_of(p):
    """Bounding boxes of one parts.json entry."""
    if p["type"] == "box":
        return [(p["lo"], p["hi"])]
    if p["type"] == "multibox":
        return [tuple(b) for b in p["boxes"]]
    if p["type"] == "cyl":
        i = "xyz".index(p["axis"][-1])
        lo = [v - p["r"] for v in p["c"]]
        hi = [v + p["r"] for v in p["c"]]
        lo[i], hi[i] = p["c"][i] - p["h"] / 2, p["c"][i] + p["h"] / 2
        return [(lo, hi)]
    if p["type"] == "poly":
        xs, ys = zip(*p["pts"])
        z0 = p["z0"]
