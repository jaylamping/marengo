 148: # ---- fasteners: M5 button heads + T-nuts on every bracket, gusset and hardpoint ---------------------
 149: FAST = {'m5': 0, 'tnut': 0, 'm4': 0}
 150: def screw(id, item, name, axis, head_pt, sign, explode, balloon=False, dia=5, head_d=8.5, head_h=4.5, length=10, color='#d8c56a'):
 151:     """Button head screw: head sits on head_pt, shank goes along axis in direction sign (into the part)."""
 152:     a = 'xyz'.index(axis); c = list(head_pt)
 153:     ch = c.copy(); ch[a] += -sign * head_h / 2
 154:     cs = c.copy(); cs[a] += sign * length / 2
 155:     cyl(id + '_h', item, name, axis, ch, head_d / 2, head_h, color, 'fastener', explode, balloon=balloon, mass_g=2, material='M%d button head' % dia)
 156:     cyl(id + '_s', item, name, axis, cs, dia / 2, length, color, 'fastener', explode, mass_g=0, material='')
 157: def tnut(id, item, name, axis, pt, sign, explode, slot_axis):
 158:     """T-nut 10 x 6 x 20 in the slot behind face point pt (face normal = axis*sign)."""
 159:     a = 'xyz'.index(axis); sa = 'xyz'.index(slot_axis)
 160:     lo = [pt[k] - 5 for k in range(3)]; hi = [pt[k] + 5 for k in range(3)]
 161:     lo[a], hi[a] = (pt[a] + sign * 1.5, pt[a] + sign * 7.5) if sign > 0 else (pt[a] + sign * 7.5, pt[a] + sign * 1.5)
 162:     lo[sa], hi[sa] = pt[sa] - 10, pt[sa] + 10
 163:     box(id, item, name, lo, hi, '#8a8d93', 'fastener', explode, mass_g=3, material='M5 T-nut')
 164: def bolt_bracket(p, idx):
 165:     """Two M5 + T-nuts for an L bracket (multibox): one through each leg into the member behind it."""
 166:     for li, (lo, hi) in enumerate(p['boxes']):
 167:         # the leg's thin axis is the bracket thickness axis; the screw goes along it, from the open side into the member
 168:         t_ax = min(range(3), key=lambda k: hi[k] - lo[k]); L = max(range(3), key=lambda k: hi[k] - lo[k])
 169:         cen = [(lo[k] + hi[k]) / 2 for k in range(3)]
 170:         # the member is on the side of the leg that is away from the bracket corner: the corner lies at the start of the long leg direction
 171:         other = p['boxes'][1 - li]; ocen = [(other[0][k] + other[1][k]) / 2 for k in range(3)]
 172:         sign = 1 if ocen[t_ax] < cen[t_ax] else -1      # member is opposite to the other leg
 173:         head = cen.copy(); head[t_ax] = hi[t_ax] if sign > 0 else lo[t_ax]
 174:         head[L] = cen[L] + (0 if True else 0)
 175:         FAST['m5'] += 1; FAST['tnut'] += 1
 176:         screw(f"f{idx}_{li}", 35, 'M5 x 10 button head + T-nut (brackets)', 'xyz'[t_ax], head, sign, p['explode'], balloon=(idx == 0 and li == 0))
 177:         slot_ax = [k for k in range(3) if k not in (t_ax, L)][0]
 178:         tn = cen.copy(); tn[t_ax] = lo[t_ax] if sign > 0 else hi[t_ax]
 179:         tnut(f"t{idx}_{li}", 35, 'M5 T-nut', 'xyz'[t_ax], tn, sign, p['explode'], 'xyz'[L] if abs(cen[L]) < 1e9 else 'xyz'[slot_ax])
 180: for idx, p in enumerate([q for q in parts if q['group'] == 'bracket']):
 181:     bolt_bracket(p, idx)
 182: # gusset bolts: 9 per plate, screws along Z into the frame, heads on the plate outer face
 183: for p in [q for q in parts if q['group'] == 'gusset']:
 184:     sz = 1 if p['z0'] > 0 else -1
 185:     for k, (x, y, r) in enumerate(p['holes']):
 186:         head = [x, y, p['z0'] + (p['t'] if sz > 0 else 0)]
 187:         screw(f"g{p['id']}_{k}", 36, 'M5 x 10 button head + T-nut (gussets, 36)', 'z', head, -sz, p['explode'], balloon=(k == 0 and p['id'] == 'gusset_1_1'))
 188:         tnut(f"gt{p['id']}_{k}", 36, 'M5 T-nut', 'z', [x, y, p['z0'] if sz > 0 else p['z0'] + p['t']], -sz, p['explode'], 'y' if abs(y - 363.62) > 1 else 'x')
 189:         FAST['m5'] += 1; FAST['tnut'] += 1
