print('meta',p['meta'],'parts',len(ps))
e=[x for x in ps if x['group']=='extrusion']
print('extrusion total',sum(x['length'] for x in e),'new',sum(x['length'] for x in e if x['source']=='new'))
print('bracket/extrusion positive-volume overlaps:')
for b in [x for x in ps if x['group']=='bracket']:
 for lo,hi in b['boxes']:
  for x in e:
   ds=[min(hi[i],x['hi'][i])-max(lo[i],x['lo'][i]) for i in range(3)]
   if min(ds)>1e-6: print(b['id'],x['id'],[round(v,3) for v in ds])
print('shelf/bracket overlaps:')
s=by['shelf']
for b in [x for x in ps if x['group']=='bracket']:
 for lo,hi in b['boxes']:
  ds=[min(hi[i],s['hi'][i])-max(lo[i],s['lo'][i]) for i in range(3)]
  if min(ds)>1e-6: print(b['id'],[round(v,3) for v in ds])
print('sample fasteners and brackets:')
for k in ['br2','br24','br25','f0_0_s','t0_0','gtgusset_1_1_6','gtgusset_1_1_7','gtgusset_1_1_8','pb1_1_390_s','hf_H3_0_s']:
 print(k,by[k])
print('tnut count',sum(x.get('material')=='M5 T-nut' for x in ps))
print('bomsum nonoption',sum(x['mass_g'] for x in json.loads(Path('data/bom.json').read_text()) if x['group']"'!='"'option'))
