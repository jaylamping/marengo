LABEL = {'rs03_pitch': 'RS03 pitch', 'rs03_boss': '', 'rs03_pitch_out': '', 'pitch_bracket': 'pitch bracket', 'pitch_wing': '', 'shelf': 'shelf', 'pi5': 'Pi 5 + HAT',
