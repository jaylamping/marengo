	(text "Hold-up bank, 20 x 68 uF, VSYS_OR to GND"
		(exclude_from_sim no)
		(at 127 264.16 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5c77221d-e7af-5403-a796-969d919af558")
	)
	(text "Ideal diode and hold-up. LM5050-1 not LM74700: PLAN 2.3 wants 75 V; LM74700 stops at 65 V, and VSYS needs no reverse-polarity function here.\n20 x 68 uF 80 V hybrid, 10 x 10.8 mm = 1.36 mF, fits the 13 mm board gap: 12.6 ms at 90 W from 46.8 V, 6.8 ms from 37 V. README claimed 1 mF for 10 ms: true only above 48 V.\nThe 24 V converter taps VSYS ahead of the diode so 75 W does not drain the hold-up."
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f1ed492-f4ab-5f34-be07-6e1d662ce2cd")
	)
