{
  "name": "marengo-pi-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Marengo Raspberry Pi bench control over SSH",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "launch": "node dist/launch.js",
    "roll-soft-verify": "node dist/cli/roll-soft-verify.js",
    "roll-degree-sweep": "node dist/cli/roll-degree-sweep.js",
    "debug-step-ok": "node dist/cli/debug-step-ok.js",
    "debug-roll-step": "node dist/cli/debug-roll-step.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
