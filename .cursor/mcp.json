{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "--package=@upstash/context7-mcp@2.2.5", "--", "context7-mcp"]
    },
    "marengo-pi": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/marengo-pi-mcp/dist/launch.js"]
    },
    "marengo-research": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/marengo-research-mcp/dist/launch.js"]
    }
  }
}
