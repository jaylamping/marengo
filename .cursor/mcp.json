{
  "mcpServers": {
    "solidworks": {
      "command": "node",
      "args": ["${workspaceFolder}/../solidworks-mcp/dist/index.js"],
      "env": {
        "SOLIDWORKS_MCP_ALLOWED_ROOTS": "${workspaceFolder}"
      }
    },
    "marengo-pi": {
      "command": "node",
      "args": ["${workspaceFolder}/tools/marengo-pi-mcp/dist/index.js"],
      "env": {
        "MARENGO_PI_HOST": "marengo.local",
        "MARENGO_PI_USER": "joey",
        "MARENGO_PI_ROOT": "/opt/marengo",
        "MARENGO_CONFIG_DIR": "/opt/marengo/config/bringup/shoulder_pitch_right_only",
        "MARENGO_BENCH_PROFILE": "bare_motor"
      }
    }
  }
}
