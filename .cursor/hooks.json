{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \".cursor/hooks/session-start-marengo.js\"",
        "timeout": 25
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \".cursor/hooks/check-powershell-shell.js\"",
        "timeout": 8,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node \".cursor/hooks/impeccable-before-edit.js\"",
        "timeout": 5
      }
    ]
  }
}
