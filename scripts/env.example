# Copy to /etc/marengo/env on the Pi (see docs/pi-commissioning.md).

MARENGO_ROOT=/opt/marengo
MARENGO_CONFIG_DIR=/opt/marengo/config

# Gate log HTTP routes (GET /logs/*) behind x-marengo-log-token header.
# Generate a random token: openssl rand -hex 32
# MARENGO_GATEWAY_LOG_TOKEN=changeme

RUST_LOG=robstride=info,davout=info,berthier=info,motor_repl=info,marengo_pi=debug,marengo_gateway=info,marengo_imu=info,imu_probe=info

# Chappe IPC socket (marengo-pi publishes; marengo-gateway subscribes)
MARENGO_CHAPPE_SOCKET=/run/marengo/chappe.sock

# Optional BNO085 IMU (enables marengo-pi background publisher on sensors/imu/torso)
# MARENGO_IMU_BUS=/dev/i2c-1
# MARENGO_IMU_ADDRESS=4b
# MARENGO_IMU_REPORT_HZ=50
# MARENGO_IMU_FRAME_ID=torso_imu

# marengo-gateway (systemd): 0.0.0.0:8080 HTTP, 0.0.0.0:8443 WebTransport — LAN bench only

# Optional: ephemeral joint allowlist for harness (3-DOF smoke on master config)
# Ephemeral wired-joint filter applied at Davout boot (enable/homing/limits) and
# the command allowlist. Unknown names fail closed. Example 3-DOF smoke:
# MARENGO_JOINT_SUBSET=right_shoulder_roll,right_shoulder_pitch,right_upper_arm_yaw
# install-pi refuses blind bringup→master migration for non-4-DOF profiles unless:
# MARENGO_ALLOW_NONEQUIV_BRINGUP_MIGRATE=1

# Optional: restrict motor-repl to one bus during debug
# MARENGO_CAN_INTERFACE=can0
