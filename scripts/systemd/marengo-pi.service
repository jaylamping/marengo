[Unit]
Description=Marengo Pi runtime (control, CAN, Chappe)
After=network-online.target marengo-can.service
Requires=marengo-can.service
Wants=network-online.target

[Service]
Type=simple
User=marengo
SupplementaryGroups=i2c
WorkingDirectory=/opt/marengo
Environment=RUST_LOG=robstride=info,davout=info,berthier=info,marengo_pi=info,marengo_imu=info,chappe=info
EnvironmentFile=-/etc/marengo/env
ExecStart=/opt/marengo/bin/marengo-pi
# Disable every drive whenever the runtime exits: normal stop, crash, panic,
# SIGKILL or a watchdog kill. Without it the drives keep their last MIT frame
# (no drive-side CAN timeout is configured; audit WP-I decision D2, option C).
# `motor-repl disable` reads only motors.yaml addresses and sends one type-4
# Disable per drive. The "-" prefix keeps a failed disable from masking the
# unit's own exit status in the journal.
ExecStopPost=-/opt/marengo/bin/motor-repl disable
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
