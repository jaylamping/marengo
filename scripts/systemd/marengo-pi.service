[Unit]
Description=Marengo Pi runtime (control, CAN, Chappe)
After=network-online.target marengo-can.service
Requires=marengo-can.service
Wants=network-online.target

[Service]
Type=simple
User=marengo
SupplementaryGroups=i2c
WorkingDirectory=/opt/marengo
Environment=RUST_LOG=robstride=info,davout=info,berthier=info,marengo_pi=info,marengo_imu=info,chappe=info
EnvironmentFile=-/etc/marengo/env
ExecStart=/opt/marengo/bin/marengo-pi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
