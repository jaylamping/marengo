# SolidWorks editor lock files
~$*

# CAD scratch copies (keep history in git, not duplicate assemblies)
hardware/cad/**/*-OLD.*
hardware/cad/**/*-OLD
hardware/cad/**/*-BROKEN*

/target/
**/*.rs.bk
.DS_Store
*.swp
*.swo
.idea/
.vscode/
*.local

# KiCad / fab artifacts (regenerate locally)
hardware/electrical/**/gerbers/
hardware/electrical/**/fp-info-cache
hardware/electrical/**/-backups/

# Frontend
consul/node_modules/
consul/.marengo-npm-stamp
tools/marengo-pi-mcp/node_modules/
tools/marengo-pi-mcp/dist/
tools/protoc-*/
consul/dist/
consul/src/gen/*
!consul/src/gen/.checksum

# Local secrets / overrides
.env
*.pem
.firecrawl/
.marengo-research/
tools/marengo-research-mcp/.venv/
tools/marengo-research-mcp/**/__pycache__/
scripts/daily-audit/__pycache__/

# Pi bench session logs (runtime on device; not committed)
var/log/

# Local deploy staging (docker cross-build rsync bundle)
.pi-deploy-staging/
.pi-deploy/
.pi-staging/
/bin/

# Local scratch notes (not docs)
/markdown
